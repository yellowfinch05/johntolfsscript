#!/usr/bin/env bash

set -euo pipefail

# These constants keep the remote host, login name, and local configuration
# location in one place. The configuration lives under XDG_CONFIG_HOME when
# it is set, while retaining the conventional ~/.config location otherwise.
readonly JOHN_HOST="john.cedarville.edu"
readonly LFS_USER="lfs"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ssh-john-lfs"
readonly CONFIG_FILE="${CONFIG_DIR}/connection.conf"

# The help text describes the two SSH hops rather than hiding the remote
# command construction. In particular, LFS-Machine-IP must run on John's
# shell, so its command substitution is deliberately preserved as backticks.
usage() {
    cat <<'EOF'
ssh-john-lfs connects to John and then to an LFS machine with one command.
It assumes SSH keys are already configured for both connections.

Usage:
  ssh-john-lfs             Connect using saved settings
  ssh-john-lfs --redo      Ask for the settings again
  ssh-john-lfs -h          Show this help

On the first run, the script asks for:
  1. Your John username (for example: jlansfo)
  2. Your LFS machine number (for example: 4)

The connection is equivalent to:
  ssh YOUR_USER@john.cedarville.edu
  ssh lfs@`LFS-Machine-IP <YOUR_MACHINE_NUMBER>`

The backticks are passed to John's shell so that LFS-Machine-IP resolves the
machine address there.

Saved settings:
  ~/.config/ssh-john-lfs/connection.conf
EOF
}

error() {
    printf 'ssh-john-lfs: %s\n' "$1" >&2
    exit 2
}

# User-provided values are inserted into an SSH command, so accept only the
# characters needed for usernames and machine numbers. This both catches
# configuration mistakes early and prevents shell syntax from being supplied
# through the prompts or saved configuration file.
valid_username() {
    [[ "$1" =~ ^[[:alnum:]_.-]+$ ]]
}

valid_machine_number() {
    [[ "$1" =~ ^[[:digit:]]+$ ]]
}

# Store the two settings with restrictive permissions because the file is
# user configuration and should not be readable or writable by other users.
save_settings() {
    local john_user=$1
    local lfs_machine_number=$2

    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    printf '%s\n%s\n' "$john_user" "$lfs_machine_number" > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

load_settings() {
    local saved_user saved_machine_number extra

    [[ -r "$CONFIG_FILE" ]] || return 1

    # Read exactly two lines. Rejecting trailing data prevents a partially
    # edited or manually corrupted file from being treated as valid settings.
    {
        IFS= read -r saved_user
        IFS= read -r saved_machine_number
        if IFS= read -r extra; then
            return 1
        fi
    } < "$CONFIG_FILE"

    valid_username "$saved_user" &&
        valid_machine_number "$saved_machine_number" || return 1
    john_user=$saved_user
    lfs_machine_number=$saved_machine_number
}

# Prompt until both values pass the same validation used for saved settings.
# Saving only after both prompts succeed avoids leaving a mixed old/new
# configuration when input is interrupted or invalid.
configure() {
    local john_user_input lfs_machine_number_input

    while :; do
        read -r -p "John username (without @${JOHN_HOST}): " john_user_input
        if valid_username "$john_user_input"; then
            break
        fi
        printf 'Enter a valid username using letters, numbers, ., _, or -.\n' >&2
    done

    while :; do
        read -r -p "LFS machine number (used by LFS-Machine-IP): " \
            lfs_machine_number_input
        if valid_machine_number "$lfs_machine_number_input"; then
            break
        fi
        printf 'Enter a machine number containing only digits.\n' >&2
    done

    save_settings "$john_user_input" "$lfs_machine_number_input"
    john_user=$john_user_input
    lfs_machine_number=$lfs_machine_number_input
    printf 'Saved settings in %s\n' "$CONFIG_FILE"
}

# Parse options before loading settings so --redo can force a fresh prompt.
# Keep option handling explicit because this script accepts no positional
# arguments and should report typos instead of ignoring them.
redo_setup=0
while (($# > 0)); do
    case "$1" in
        --redo|--reset)
            redo_setup=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error "unknown option: $1 (use -h for help)"
            ;;
    esac
done

john_user=""
lfs_machine_number=""
if ((redo_setup)) || ! load_settings; then
    configure
fi

# Build the second hop as a command string for John's shell. The backticks
# must survive the local shell so that LFS-Machine-IP resolves the address on
# the intermediate host, not on the user's local machine.
printf 'Connecting to %s@%s, then %s@`LFS-Machine-IP %s`...\n' \
    "$john_user" "$JOHN_HOST" "$LFS_USER" "$lfs_machine_number"
remote_command='ssh -tt '"${LFS_USER}"'@`LFS-Machine-IP '"$lfs_machine_number"'`'
exec ssh -tt "${john_user}@${JOHN_HOST}" "$remote_command"
